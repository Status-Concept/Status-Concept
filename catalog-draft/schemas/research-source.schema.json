{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statusconcept.local/schemas/research-source.schema.json",
  "title": "Status Concept research source",
  "type": "object",
  "required": [
    "url",
    "sourceType",
    "retrievedAt",
    "matchedBy",
    "confidence",
    "fieldsSupported"
  ],
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "sourceType": {
      "enum": ["status-concept", "manufacturer", "supplier"]
    },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "matchedBy": {
      "enum": ["reference", "model", "collection", "manual"]
    },
    "confidence": {
      "enum": ["exact", "high", "medium", "uncertain"]
    },
    "fieldsSupported": {
      "type": "array",
      "items": { "type": "string" }
    },
    "method": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
